# Copy to .env.local for local dev, or set these as real env vars / a
# systemd EnvironmentFile in production. Never commit a filled-in copy.

# --- Auth (Google OAuth, Authlib) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
DASHBOARD_WORKSPACE_DOMAIN=iconsofrealestate.com
DASHBOARD_ALLOWED_EMAILS=kris@iconsofrealestate.com,joana@iconsofrealestate.com
DASHBOARD_SESSION_SECRET=

# Skips real Google login entirely, auto-logging in as a fake dev user --
# for local click-through only. Safe to leave "true" in a LOCAL .env: it's
# ignored the instant GOOGLE_OAUTH_CLIENT_ID above is filled in, so real
# login always wins the moment it's actually configured. Never set this
# in the production .env on the VPS.
DASHBOARD_DEV_BYPASS_AUTH=true

# --- Data source (spam_machine's Sheet) ---
# "mock" (default) needs nothing below this line filled in -- sync.py
# pulls from fixtures.py instead, so the whole dashboard can be run and
# clicked through before any service account or Sheet-sharing exists.
# Switch to "live" once the two service account files below are real.
DASHBOARD_SYNC_MODE=mock

# CONFIG.SPREADSHEET_ID from the repo root's Code.gs.
SPAM_MACHINE_SHEET_ID=1uDrt3WAPZR90iaPgM6wZcfN9rOXzkkuFHJ6tg_XMHHs

# Read-only service account (Viewer on the Sheet) -- used by sync.py.
DASHBOARD_SERVICE_ACCOUNT_FILE=service_account.json

# Write-capable service account (Editor on the Sheet) -- used by
# sheets_write.py for SOP suggestion approve/reject/comment. Can be the
# SAME account as above if you just grant it Editor instead of Viewer;
# kept as a separate var so read and write can be split onto two
# credentials later if that's preferred.
DASHBOARD_WRITE_SERVICE_ACCOUNT_FILE=service_account_write.json

# --- Local paths / bind ---
DASHBOARD_DB_PATH=dashboard.db
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_BIND_PORT=8010
