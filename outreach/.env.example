# Copy to .env for local dev, or set as real env vars / a systemd
# EnvironmentFile in production. Never commit a filled-in copy.

# --- Auth (Google OAuth, Authlib) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
OUTREACH_WORKSPACE_DOMAIN=iconsofrealestate.com
OUTREACH_ALLOWED_EMAILS=kris@iconsofrealestate.com
OUTREACH_SESSION_SECRET=

# Skips real Google login for local dev -- see dashboard/.env.example for
# the same pattern and its safety rail (ignored once GOOGLE_OAUTH_CLIENT_ID
# is set). Never set this in the production .env.
OUTREACH_DEV_BYPASS_AUTH=true

# --- Sourcing (finding sponsors/guests) ---
# "mock" (default): sourcing.py returns fixture data, no API keys needed.
# No real provider is wired up yet -- see sourcing.py and
# research/2026-08-26_growth-features-research.md for what "live" needs
# (Google Places API + Apollo.io for sponsors, Podchaser for guests).
OUTREACH_SOURCING_MODE=mock

# --- Local paths / bind ---
OUTREACH_DB_PATH=outreach.db
OUTREACH_BIND_HOST=127.0.0.1
OUTREACH_BIND_PORT=8020
